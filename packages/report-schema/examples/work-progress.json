{
  "schemaVersion": 1,
  "titleFormat": "{{teamName}} 업무 진행 현황 ({{period.start}}~{{period.end}})",
  "instructions": "팀장에게 보고하는 문서입니다. 간결한 보고체(~함, ~임)로 작성합니다.",
  "variables": [
    { "key": "teamName", "label": "팀 이름", "type": "TEXT", "required": true },
    { "key": "period", "label": "기간", "type": "DATE_RANGE", "required": true },
    {
      "key": "reportType",
      "label": "보고 주기",
      "type": "SELECT",
      "required": false,
      "options": { "choices": ["주간", "월간"] }
    }
  ],
  "sections": [
    {
      "key": "summary",
      "title": "요약",
      "fields": [
        {
          "key": "headline",
          "label": "한 줄 요약",
          "type": "TEXT",
          "required": true,
          "instructions": "이번 기간 가장 중요한 변화 한 가지를 한 문장으로 씁니다.",
          "options": { "maxLength": 120 }
        }
      ]
    },
    {
      "key": "progress",
      "title": "업무 진행 현황",
      "instructions": "메일에 나온 업무만 적고, 메일에 없는 업무는 추측해서 추가하지 않습니다.",
      "fields": [
        {
          "key": "items",
          "label": "진행 항목",
          "type": "TABLE",
          "required": true,
          "instructions": "업무 단위로 한 행씩 씁니다. 같은 업무에 대한 여러 메일은 한 행으로 합칩니다.",
          "options": {
            "columns": [
              { "key": "task", "label": "업무", "type": "TEXT", "options": { "maxLength": 100 } },
              { "key": "owner", "label": "담당", "type": "TEXT" },
              {
                "key": "status",
                "label": "상태",
                "type": "SELECT",
                "options": { "choices": ["진행 중", "완료", "지연", "보류"] }
              },
              { "key": "progressRate", "label": "진척률", "type": "NUMBER", "options": { "unit": "%", "min": 0, "max": 100 } },
              { "key": "dueDate", "label": "마감일", "type": "DATE" }
            ],
            "maxRows": 20
          }
        }
      ]
    },
    {
      "key": "risks",
      "title": "이슈 및 리스크",
      "fields": [
        {
          "key": "issues",
          "label": "주요 이슈",
          "type": "LIST",
          "required": false,
          "instructions": "일정 지연, 고객 불만, 의사결정이 필요한 사항을 씁니다.",
          "options": { "maxItems": 10 }
        },
        {
          "key": "riskLevel",
          "label": "전체 위험도",
          "type": "SELECT",
          "required": true,
          "options": { "choices": ["낮음", "보통", "높음"] }
        }
      ]
    },
    {
      "key": "nextSteps",
      "title": "다음 기간 계획",
      "fields": [
        {
          "key": "plan",
          "label": "계획",
          "type": "RICH_TEXT",
          "required": false,
          "instructions": "메일에 언급된 일정과 약속을 바탕으로 씁니다.",
          "options": { "maxLength": 1500 }
        },
        {
          "key": "nextReviewDate",
          "label": "다음 점검일",
          "type": "DATE",
          "required": false
        }
      ]
    }
  ]
}
