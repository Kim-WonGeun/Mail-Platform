{
  "schemaVersion": 1,
  "titleFormat": "{{productName}} 고객 문의 분석 ({{period.start}}~{{period.end}})",
  "instructions": "고객 지원팀 회의에서 공유하는 문서입니다. 고객 표현을 과장하거나 추측하지 않습니다.",
  "variables": [
    { "key": "productName", "label": "제품명", "type": "TEXT", "required": true },
    { "key": "period", "label": "기간", "type": "DATE_RANGE", "required": true }
  ],
  "sections": [
    {
      "key": "notice",
      "title": "안내",
      "fields": [
        {
          "key": "disclaimer",
          "label": "안내 문구",
          "type": "STATIC",
          "content": "이 보고서는 수신 메일을 AI로 분석해 자동 생성했습니다. 고객 응대 전에 원문을 확인해 주세요."
        }
      ]
    },
    {
      "key": "summary",
      "title": "요약",
      "fields": [
        {
          "key": "inquiryCount",
          "label": "문의 건수",
          "type": "NUMBER",
          "required": true,
          "instructions": "서로 다른 고객 문의의 수입니다. 같은 문의의 회신은 한 건으로 셉니다.",
          "options": { "unit": "건", "min": 0 }
        },
        {
          "key": "overallSentiment",
          "label": "전반적 고객 반응",
          "type": "SELECT",
          "required": true,
          "options": { "choices": ["긍정", "중립", "부정"] }
        },
        {
          "key": "analysis",
          "label": "분석",
          "type": "RICH_TEXT",
          "required": true,
          "instructions": "문의가 많은 유형과 그 원인으로 보이는 점을 두세 문단으로 씁니다.",
          "options": { "maxLength": 2000 }
        }
      ]
    },
    {
      "key": "inquiries",
      "title": "문의 목록",
      "fields": [
        {
          "key": "rows",
          "label": "문의 목록",
          "type": "TABLE",
          "required": true,
          "instructions": "문의 한 건을 한 행으로 씁니다.",
          "options": {
            "columns": [
              { "key": "customer", "label": "고객", "type": "TEXT", "instructions": "회사명 또는 발신자 이메일" },
              {
                "key": "category",
                "label": "유형",
                "type": "SELECT",
                "options": { "choices": ["기능 문의", "오류 신고", "요금·계약", "기능 요청", "기타"] }
              },
              { "key": "request", "label": "요청 내용", "type": "TEXT", "options": { "maxLength": 200 } },
              {
                "key": "urgency",
                "label": "긴급도",
                "type": "SELECT",
                "options": { "choices": ["높음", "보통", "낮음"] }
              },
              { "key": "receivedAt", "label": "접수일", "type": "DATE" }
            ],
            "maxRows": 50
          }
        }
      ]
    },
    {
      "key": "recommendations",
      "title": "개선 제안",
      "fields": [
        {
          "key": "items",
          "label": "개선 제안",
          "type": "LIST",
          "required": false,
          "instructions": "반복되는 문의를 줄일 수 있는 제안만 씁니다.",
          "options": { "maxItems": 5 }
        }
      ]
    }
  ]
}
