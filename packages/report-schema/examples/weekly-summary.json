{
  "schemaVersion": 1,
  "titleFormat": "주간 요약 ({{period.start}}~{{period.end}})",
  "instructions": "한 주 동안 받은 메일을 바탕으로 본인이 읽을 요약을 작성합니다. 짧고 핵심만 씁니다.",
  "variables": [
    { "key": "period", "label": "기간", "type": "DATE_RANGE", "required": true }
  ],
  "sections": [
    {
      "key": "overview",
      "title": "한 주 요약",
      "fields": [
        {
          "key": "headline",
          "label": "한 줄 요약",
          "type": "TEXT",
          "required": true,
          "instructions": "이번 주 가장 중요한 일 한 가지를 한 문장으로 씁니다.",
          "options": { "maxLength": 120 }
        },
        {
          "key": "mailCount",
          "label": "검토한 메일 수",
          "type": "NUMBER",
          "required": false,
          "instructions": "소스로 받은 메일 수를 셉니다.",
          "options": { "unit": "통", "min": 0 }
        }
      ]
    },
    {
      "key": "highlights",
      "title": "주요 내용",
      "fields": [
        {
          "key": "items",
          "label": "주요 내용",
          "type": "LIST",
          "required": true,
          "instructions": "중요한 순서로 정리합니다. 같은 주제의 메일은 한 항목으로 합칩니다.",
          "options": { "minItems": 1, "maxItems": 7 }
        }
      ]
    },
    {
      "key": "followUps",
      "title": "다음 주 할 일",
      "fields": [
        {
          "key": "actions",
          "label": "후속 작업",
          "type": "LIST",
          "required": false,
          "instructions": "메일에서 요청받았거나 약속한 일만 적습니다.",
          "options": { "maxItems": 10 }
        }
      ]
    }
  ]
}
