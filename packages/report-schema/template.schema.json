{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mail-platform.local/schemas/report-template/v1.json",
  "title": "보고서 양식 스키마",
  "description": "report_template_versions.schema_snapshot에 저장하는 양식 정의입니다. web 빌더, api 검증, agent 생성, 렌더러가 모두 이 형식을 읽습니다. 키 중복, 제목 변수 참조처럼 JSON Schema로 표현할 수 없는 규칙은 validate.py와 각 앱의 검증 코드가 확인합니다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "titleFormat", "sections"],
  "properties": {
    "schemaVersion": {
      "description": "이 문서 형식의 버전입니다. 형식이 호환되지 않게 바뀌면 올립니다.",
      "const": 1
    },
    "titleFormat": {
      "description": "생성 보고서 제목. {{변수키}} 또는 기간 변수의 {{변수키.start}}, {{변수키.end}}를 쓸 수 있습니다.",
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "instructions": {
      "description": "보고서 전체 작성 지침 (독자, 어조, 분량)",
      "$ref": "#/$defs/instructions"
    },
    "variables": {
      "description": "생성 요청 시 사용자가 입력하는 값",
      "type": "array",
      "maxItems": 20,
      "items": { "$ref": "#/$defs/variable" }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": { "$ref": "#/$defs/section" }
    }
  },
  "$defs": {
    "key": {
      "description": "코드에서 쓰는 식별자. 소문자로 시작하는 camelCase입니다.",
      "type": "string",
      "pattern": "^[a-z][a-zA-Z0-9]*$",
      "maxLength": 80
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 150
    },
    "instructions": {
      "description": "AI에게 무엇을 어떻게 쓸지 알려주는 지침",
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "choices": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 100 }
    },

    "variable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label", "type", "required"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "label": { "$ref": "#/$defs/label" },
        "type": { "enum": ["TEXT", "NUMBER", "DATE", "DATE_RANGE", "SELECT"] },
        "required": { "type": "boolean" },
        "options": { "type": "object" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "SELECT" } } },
          "then": {
            "required": ["options"],
            "properties": { "options": { "$ref": "#/$defs/selectOptions" } }
          },
          "else": { "properties": { "options": false } }
        }
      ]
    },

    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "title", "fields"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "title": { "$ref": "#/$defs/label" },
        "instructions": { "$ref": "#/$defs/instructions" },
        "fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": { "$ref": "#/$defs/field" }
        }
      }
    },

    "field": {
      "description": "type에 따라 options 형태가 달라집니다. STATIC은 AI를 쓰지 않는 고정 문구입니다.",
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label", "type"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "label": { "$ref": "#/$defs/label" },
        "type": {
          "enum": ["TEXT", "RICH_TEXT", "NUMBER", "DATE", "SELECT", "MULTI_SELECT", "LIST", "TABLE", "STATIC"]
        },
        "required": { "type": "boolean" },
        "instructions": { "$ref": "#/$defs/instructions" },
        "options": { "type": "object" },
        "content": {
          "description": "STATIC 필드의 고정 문구 (Markdown)",
          "type": "string",
          "minLength": 1,
          "maxLength": 5000
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "STATIC" } } },
          "then": {
            "required": ["content"],
            "properties": { "required": false, "instructions": false, "options": false }
          },
          "else": {
            "required": ["required"],
            "properties": { "content": false }
          }
        },
        {
          "if": { "properties": { "type": { "enum": ["TEXT", "RICH_TEXT"] } } },
          "then": { "properties": { "options": { "$ref": "#/$defs/textOptions" } } }
        },
        {
          "if": { "properties": { "type": { "const": "NUMBER" } } },
          "then": { "properties": { "options": { "$ref": "#/$defs/numberOptions" } } }
        },
        {
          "if": { "properties": { "type": { "const": "DATE" } } },
          "then": { "properties": { "options": false } }
        },
        {
          "if": { "properties": { "type": { "enum": ["SELECT", "MULTI_SELECT"] } } },
          "then": {
            "required": ["options"],
            "properties": { "options": { "$ref": "#/$defs/selectOptions" } }
          }
        },
        {
          "if": { "properties": { "type": { "const": "LIST" } } },
          "then": { "properties": { "options": { "$ref": "#/$defs/listOptions" } } }
        },
        {
          "if": { "properties": { "type": { "const": "TABLE" } } },
          "then": {
            "required": ["options"],
            "properties": { "options": { "$ref": "#/$defs/tableOptions" } }
          }
        }
      ]
    },

    "textOptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxLength": { "type": "integer", "minimum": 1, "maximum": 20000 }
      }
    },
    "numberOptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "unit": { "type": "string", "minLength": 1, "maxLength": 20 },
        "min": { "type": "number" },
        "max": { "type": "number" }
      }
    },
    "selectOptions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["choices"],
      "properties": {
        "choices": { "$ref": "#/$defs/choices" }
      }
    },
    "listOptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minItems": { "type": "integer", "minimum": 0, "maximum": 100 },
        "maxItems": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    },
    "tableOptions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["columns"],
      "properties": {
        "columns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": { "$ref": "#/$defs/column" }
        },
        "maxRows": { "type": "integer", "minimum": 1, "maximum": 200 }
      }
    },

    "column": {
      "description": "표의 열. 표 안에 표나 긴 서술형은 넣지 않습니다.",
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label", "type"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "label": { "$ref": "#/$defs/label" },
        "type": { "enum": ["TEXT", "NUMBER", "DATE", "SELECT", "MULTI_SELECT"] },
        "instructions": { "$ref": "#/$defs/instructions" },
        "options": { "type": "object" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "TEXT" } } },
          "then": { "properties": { "options": { "$ref": "#/$defs/textOptions" } } }
        },
        {
          "if": { "properties": { "type": { "const": "NUMBER" } } },
          "then": { "properties": { "options": { "$ref": "#/$defs/numberOptions" } } }
        },
        {
          "if": { "properties": { "type": { "const": "DATE" } } },
          "then": { "properties": { "options": false } }
        },
        {
          "if": { "properties": { "type": { "enum": ["SELECT", "MULTI_SELECT"] } } },
          "then": {
            "required": ["options"],
            "properties": { "options": { "$ref": "#/$defs/selectOptions" } }
          }
        }
      ]
    }
  }
}
